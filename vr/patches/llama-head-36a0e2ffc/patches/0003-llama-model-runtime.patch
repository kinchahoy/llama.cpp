+    }
+    if (!best) {
+        return false;
+    }
+    for (const auto & backend_ev : best->events) {
+        ggml_backend_event_synchronize(backend_ev.event);
+    }
+    return true;
+}
+
+bool llama_context::layer_inp_accum_ready_epoch(uint64_t epoch) {
+    if (epoch == 0) {
