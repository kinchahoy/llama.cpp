+
+bool llama_context::layer_inp_accum_wait_epoch(uint64_t epoch) {
+    if (epoch == 0) {
+        return false;
+    }
+    const layer_inp_accum_ev * best = nullptr;
+    for (const auto & ev : layer_inp_accum_events) {
+        if (!ev.events.empty() && ev.epoch >= epoch && (!best || ev.epoch < best->epoch)) {
+            best = &ev;
