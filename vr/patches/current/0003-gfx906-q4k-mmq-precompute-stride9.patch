+        const int * __restrict__ v, const int * __restrict__ u,
+        const half2 * __restrict__ dmA, const half2 * __restrict__ ds8) {
+    float sumf = 0.0f;
+
+#pragma unroll
+    for (int i = 0; i < QR4_K*VDR_Q4_K_Q8_1_MMQ/QI8_1; ++i) {
+        int sumi_d = 0;
