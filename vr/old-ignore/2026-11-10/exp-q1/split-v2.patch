+// Same result as add_rms_norm_mul_f32, but blockIdx.y picks a slice of block_size output columns.
+// Every block computes the full-row sum of squares in the same order, so the scale is identical.
+template <int block_size>
+static __global__ void add_rms_norm_mul_split_f32(
+        const float * a, const float * b, float * sum, const float * w, float * dst,
+        block_q8_1 * q, const int ncols, const int ncols_padded, const float eps) {
+    const int64_t row = blockIdx.x;
+    const int     tid = threadIdx.x;
+    const int     col = blockIdx.y*block_size + tid;
+
+    extern __shared__ float s_sum[];
+
+    a   += row*ncols;
+    b   += row*ncols;
+    sum += row*ncols;
+    dst += row*ncols;
+
+    const float wc = col < ncols ? w[col] : 0.0f;
+    float xc  = 0.0f;
+    float tmp = 0.0f;
+    for (int c = tid; c < ncols; c += block_size) {
+        const float xi = a[c] + b[c];
+        xc   = c == col ? xi : xc;
+        tmp += xi * xi;
+    }
+
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean  = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+
+    float xi = 0.0f;
+    if (col < ncols) {
+        sum[col] = xc;
+        xi = scale * xc * wc;
+        dst[col] = xi;
+    }
+
+    static_assert(block_size % QK8_1 == 0, "Q8_1 groups must not cross blocks");
+    // whole 32-lane groups are in or out, so the shuffles below see full groups
+    if (q == nullptr || blockIdx.y*block_size + (tid & ~(QK8_1 - 1)) >= ncols_padded) {
+        return;
+    }
+    block_q8_1 * qrow = q + row*(ncols_padded/QK8_1);
+    const float amax = warp_reduce_max<QK8_1>(fabsf(xi));
+    const float xsum = warp_reduce_sum<QK8_1>(xi);
+    const float d    = amax / 127.0f;
+    const int   iqs  = col % QK8_1;
+    qrow[col / QK8_1].qs[iqs] = amax == 0.0f ? 0 : roundf(xi / d);
+    if (iqs == 0) {
+        qrow[col / QK8_1].ds = make_half2(d, xsum);
+    }
+}
