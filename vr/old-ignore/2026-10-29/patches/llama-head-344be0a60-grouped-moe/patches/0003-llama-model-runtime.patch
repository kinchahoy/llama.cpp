+void llama_context::layer_inp_accum_events_free() {
+    for (auto & ev : layer_inp_accum_events) {
+        for (auto & backend_ev : ev.events) {
+            if (backend_ev.event) {
+                ggml_backend_event_free(backend_ev.event);
