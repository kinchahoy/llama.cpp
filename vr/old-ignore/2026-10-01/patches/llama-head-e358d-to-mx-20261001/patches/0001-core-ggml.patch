+        "%s: us total=%" PRId64 " stage_wait=%" PRId64 " memcpy=%" PRId64
+        " dst_wait=%" PRId64 " set_async=%" PRId64 " stage_record=%" PRId64
+        " input_wait=%" PRId64 " input_copy=%" PRId64 "\n",
