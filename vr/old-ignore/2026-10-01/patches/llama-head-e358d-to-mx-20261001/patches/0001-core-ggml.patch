+                }
+
+                tge->failed = true;
+                backend_ctx->tg_free_entry(*tge);
+                GGML_LOG_DEBUG("%s: uid %zu capture failed, using per-subgraph dispatch\n",
+                               __func__, (size_t) cgraph->uid);
+            }
