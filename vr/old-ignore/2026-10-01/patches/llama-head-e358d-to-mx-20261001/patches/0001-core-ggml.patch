+            ggml_tensor * n0 = cg0->nodes[cg0->n_nodes - 1];
+            ggml_backend_synchronize(bc0.backend);
+            for (size_t j = lane_lo + 1; j < lane_hi; j++) {
+                auto & bcj = backend_ctx->backend_configs[j];
+                ggml_cgraph * cgj = bcj.cgraphs[i].cgraph_main;
