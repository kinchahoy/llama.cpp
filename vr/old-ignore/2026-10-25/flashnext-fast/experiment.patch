+
+class llm_graph_input_mtp_device : public llm_graph_input_embd_h {
+public:
+    llm_graph_input_mtp_device(llama_mtp_device * state, int64_t n_embd, int64_t n_hidden)
+        : llm_graph_input_embd_h(n_embd, n_hidden), state(state) {}
+
+    void set_input(const llama_ubatch * ubatch) override {
+        if (!state->active || !state->feedback) {
+            if (!state->active) {
+                ggml_backend_sched_synchronize(state->owner->get_sched());
+            }
+            llm_graph_input_embd_h::set_input(ubatch);
+            return;
+        }
+        GGML_ASSERT(ubatch->n_tokens == 1 && ubatch->token);
+        // The previous step wrote the persistent input buffers on this stream.
+    }
+
+private:
+    llama_mtp_device * state;
+};
+
+std::unique_ptr<llm_graph_input_embd_h> llama_mtp_device_input(llama_mtp_device * state, int64_t n_embd, int64_t n_hidden) {
+    return std::make_unique<llm_graph_input_mtp_device>(state, n_embd, n_hidden);
+}
+
+void llama_mtp_device_build(ggml_context * ctx, ggml_cgraph * gf, llama_mtp_device * state, ggml_tensor * hidden, ggml_tensor * logits) {
+    // Keep the same top-10 confidence used by the generic MTP sampler.
+    auto * ids = ggml_top_k(ctx, logits, 10);
+    auto * top = ggml_get_rows(ctx, ggml_reshape_3d(ctx, logits, 1, logits->ne[0], 1), ids);
+    auto * probs = ggml_soft_max(ctx, ggml_reshape_2d(ctx, top, 10, 1));
+    // TOP_K returns an unordered set, so select its maximum before feeding back.
+    auto * best = ggml_argmax(ctx, probs);
+    auto * token = ggml_get_rows(ctx, ggml_reshape_2d(ctx, ids, 1, 10), best);
+    auto * probability = ggml_get_rows(ctx, ggml_reshape_2d(ctx, probs, 1, 10), best);
+    ggml_build_forward_expand(gf, ggml_cpy(ctx, hidden, state->hidden));
+    ggml_build_forward_expand(gf, ggml_cpy(ctx, token, state->token));
+    ggml_build_forward_expand(gf, ggml_cpy(ctx, probability, state->probability));
+}
+
+int32_t llama_context::mtp_device_draft(llama_token token, llama_pos pos, const float * hidden, int32_t n_max, float p_min, llama_token * tokens) {
+    const char * env = std::getenv("LLAMA_QWEN4_MTP_DEVICE");
+    if (!env || std::strcmp(env, "1") != 0 || model.arch != LLM_ARCH_QWEN4EXP ||
+            cparams.ctx_type != LLAMA_CONTEXT_TYPE_MTP || cparams.n_seq_max != 1 ||
+            model.devices.size() != 1 || model.split_mode() == LLAMA_SPLIT_MODE_TENSOR ||
+            ggml_backend_dev_type(model.dev_output()) != GGML_BACKEND_DEVICE_TYPE_GPU ||
+            n_max < 1 || n_max > 16 || pos < 0 || pos > std::numeric_limits<llama_pos>::max() - n_max || !hidden || !tokens) {
+        return -1;
+    }
+
+    if (!mtp_device) {
+        auto state = std::make_unique<llama_mtp_device>();
+        state->meta.reset(ggml_init({3*ggml_tensor_overhead(), nullptr, true}));
+        if (!state->meta) {
+            return -1;
+        }
+        state->hidden = ggml_new_tensor_2d(state->meta.get(), GGML_TYPE_F32, model.hparams.n_embd_out(), 1);
+        state->token = ggml_new_tensor_1d(state->meta.get(), GGML_TYPE_I32, 1);
+        state->probability = ggml_new_tensor_1d(state->meta.get(), GGML_TYPE_F32, 1);
+        state->buffer.reset(ggml_backend_alloc_ctx_tensors_from_buft(state->meta.get(), ggml_backend_dev_buffer_type(model.dev_output())));
+        if (!state->buffer) {
+            return -1;
+        }
+        auto * host_type = ggml_backend_dev_host_buffer_type(model.dev_output());
+        if (!host_type) {
+            return -1;
+        }
+        state->host_buffer.reset(ggml_backend_buft_alloc_buffer(host_type, 16*(sizeof(llama_token) + sizeof(float))));
+        if (!state->host_buffer) {
+            return -1;
+        }
+        state->owner = this;
+        synchronize();
+        mtp_device = std::move(state);
+        cparams.mtp_device = mtp_device.get();
+        sched_need_reserve = true;
+        sched_reserve();
+        LLAMA_LOG_INFO("%s: device MTP feedback enabled on %s\n", __func__, ggml_backend_dev_name(model.dev_output()));
+    }
+
+    auto & state = *mtp_device;
+    synchronize();
+    state.active = true;
+    state.feedback = false;
+    auto * draft_tokens = static_cast<llama_token *>(ggml_backend_buffer_get_base(state.host_buffer.get()));
+    auto * probabilities = reinterpret_cast<float *>(draft_tokens + 16);
+    auto * batch = llama_batch_ext_init(this);
+    int32_t count = 0;
+    for (; count < n_max; ++count) {
+        llama_batch_ext_clear(batch);
+        const int32_t idx = llama_batch_ext_add_token(batch, 0, token);
+        const llama_pos position = pos + count;
+        llama_batch_ext_set_pos(batch, idx, &position);
+        llama_batch_ext_set_output_logits(batch, idx, true);
+        llama_batch_ext_set_embd_state(batch, idx, {hidden, 1, model.hparams.n_embd_out()});
+        // The memory inputs reuse GPU metadata buffers between decode calls.
+        if (count > 0) {
+            ggml_backend_sched_synchronize(sched.get());
+        }
+        if (decode(*batch) != 0) {
+            break;
+        }
+        auto * backend = ggml_backend_sched_get_tensor_backend(sched.get(), get_gf_res_prev()->get_h_nextn());
+        ggml_backend_tensor_get_async(backend, state.token, draft_tokens + count, 0, sizeof(llama_token));
+        ggml_backend_tensor_get_async(backend, state.probability, probabilities + count, 0, sizeof(float));
+        state.feedback = true;
+    }
+    synchronize();
+    state.active = false;
+    state.feedback = false;
+    llama_batch_ext_free(batch);
+    std::copy_n(draft_tokens, count, tokens);
+    for (int32_t i = 0; i < count; ++i) {
+        if (!std::isfinite(probabilities[i]) || probabilities[i] < p_min) {
+            return i;
+        }
+    }
+    return count;
+}
+
+int32_t llama_mtp_device_draft(llama_context * ctx, llama_token token, llama_pos pos, const float * hidden, int32_t n_max, float p_min, llama_token * tokens) {
+    return ctx->mtp_device_draft(token, pos, hidden, n_max, p_min, tokens);
+}
