-    if (dst->type != GGML_TYPE_F32) {
-        return false;
-    }
-
-    if (src0->ne[2] > 512) {
-        return false;
-    }
-
-    if (src1) {
-        if (src1->type != GGML_TYPE_F32 && src1->type != GGML_TYPE_F16) {
-            return false;
-        }
-        if (src0->ne[0] != src1->ne[0]) {
