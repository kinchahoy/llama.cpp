-        }
-        if (src1->ne[1] < src0->ne[1]) {
-            return false;
-        }
-        if (src0->ne[2] % src1->ne[2] != 0) {
-            return false;
-        }
-        if (src0->ne[3] % src1->ne[3] != 0) {
-            return false;
-        }
-    }
-
-    if (src1) {
-        if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(src1) || !ggml_is_contiguous(dst)) {
