+    ml.get_key(LLM_KV_ENGRAM_MAX_NGRAM_SIZE,        hparams.engram_max_ngram_size,   false);
+    ml.get_key(LLM_KV_ENGRAM_PAD_TOKEN_ID,          hparams.engram_pad_token_id,     false);
