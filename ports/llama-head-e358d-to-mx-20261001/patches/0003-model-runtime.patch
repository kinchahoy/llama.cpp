+        if (r == 0 || r == lo || r == hi) {
+            continue;
+        }
+        if (hi == 0 || r > hi) {
+            lo = hi;
+            hi = r;
+        } else if (lo == 0 || r > lo) {
+            lo = r;
+        } else {
+            throw std::runtime_error("deepseek41: more than two compression ratios");
+        }
