+GDN_GCN_DPP_ADD(gdn_dpp_add_xor1, "s_nop 4\n", "quad_perm:[1,0,3,2]")
+GDN_GCN_DPP_ADD(gdn_dpp_add_xor2, "s_nop 1\n", "quad_perm:[2,3,0,1]")
+GDN_GCN_DPP_ADD(gdn_dpp_add_xor8, "s_nop 1\n", "row_ror:8")
